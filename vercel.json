{
  "version": 2,
  "functions": {
    "api/send-mail.js": {
      "maxDuration": 30
    },
    "api/upload-url.js": {
      "maxDuration": 10
    },
    "api/delete-file.js": {
      "maxDuration": 30
    },
    "api/tracks.js": {
      "maxDuration": 30
    },
    "api/login.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}